# Server
PORT=5000
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Admin login. Used only the first time the server starts;
# after that the (hashed) password lives in data/auth.json and can be changed from the dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Secret used to sign login tokens. Change this to a long random string.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
