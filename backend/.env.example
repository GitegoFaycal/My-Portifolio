# ---- Server ----
PORT=5000
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173
# Set to true on Vercel to also allow *.vercel.app preview deployments of the frontend
ALLOW_VERCEL_PREVIEWS=false

# ---- Admin login ----
# Used only the first time the server starts; after that the hashed password is stored
# (data/auth.json locally, Redis on Vercel) and can be changed from the dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Secret used to sign login tokens. Change this to a long random string.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- Storage ----
# Leave empty to auto-detect: "vercel" when the variables below exist, otherwise "file".
STORAGE=
# Upstash Redis (Vercel Marketplace adds these automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Blob (Vercel adds this automatically)
BLOB_READ_WRITE_TOKEN=
